generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  password      String    @default("")  // Empty for OAuth users
  name          String?   // Nickname (display name)
  legalName     String?   // Legal/full name
  avatar        String?
  bio           String?
  phone         String?
  location      String?
  birthday      DateTime?
  role          String    @default("VIEWER")
  membershipType String   @default("VIEWER")  // "VIEWER", "BASIC", "PREMIUM"
  membershipExpiresAt DateTime?
  stripeCustomerId String?
  stripeSubscriptionId String?
  freeUploadsUsed Int      @default(0)      // Track free uploads used this period
  freeUploadsResetAt DateTime?              // When to reset free upload count
  paidUploadCredits Int     @default(0)      // Paid upload credits from Stripe payments
  emailVerified Boolean   @default(false)
  verificationToken String?
  verificationExpires DateTime?
  policyAgreedAt DateTime?  // When user agreed to Terms of Service and Privacy Policy
  pwaInstalledAt DateTime?  // Server-side record of PWA installation (survives cache clears)
  
  // Admin moderation fields
  isSuspended   Boolean   @default(false)    // Account suspended
  suspendedAt   DateTime?                     // When suspended
  suspendedUntil DateTime?                    // Suspension end date (null = permanent)
  suspendReason String?                       // Reason for suspension
  warningCount  Int       @default(0)         // Number of warnings received
  lastWarningAt DateTime?                     // Last warning date
  lastWarningReason String?                   // Last warning reason
  bonusCredits  Int       @default(0)         // Bonus credits given by admin
  creditsUsed   Int       @default(0)         // Total credits consumed (for display)
  adminNotes    String?                       // Internal admin notes
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  media         Media[]
  comments      Comment[]
  ratings       Rating[]
  sentMessages  Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  reports       Report[]
  purchases     Purchase[] @relation("Purchases")
  savedMedia    SavedMedia[]
  notifications Notification[]
  chatMessages  ChatMessage[]
  pendingUploads PendingUpload[]
  conversationMemberships ConversationMember[]
  creditHistory CreditHistory[]
  celebrationCardsSent CelebrationCard[] @relation("CelebrationCardSender")
}

model Media {
  id            String    @id @default(uuid())
  title         String
  description   String?
  type          String
  url           String                      // Free streaming URL (720p for video after processing)
  urlHq         String?                     // High-quality URL (4K/source-max for paid download)
  fileSize      BigInt?                     // bytes (from blob properties)
  thumbnailUrl  String?
  aiTool        String?
  realDevice    String?
  aiPrompt      String?
  price         Float?    // null = free, otherwise price in USD
  views         Int       @default(0)
  downloadCount Int       @default(0)
  shareCount    Int       @default(0)
  processingStatus String @default("completed") // "pending", "processing", "completed", "failed"
  processingError  String?                      // Error message if processing failed
  // VIDEO: success email/notification deferred until processing completes (home feed ready)
  uploadSuccessNotifySource String?            // free | premium | credit | stripe_fee | per_upload
  uploadLiveNotifiedAt     DateTime?           // set after deferred user-facing "live" notify sent
  cropData         Json?                        // { x, y, width, height } from crop tool — used by cron processor
  trimStart        Float?                       // video trim start (seconds); used by cron processor
  trimEnd          Float?                      // video trim end (seconds)
  isPublic      Boolean   @default(true)
  isApproved    Boolean   @default(true)
  isSold        Boolean   @default(false)  // true after purchased & downloaded
  soldAt        DateTime?                  // when item was sold/downloaded
  deleteAfter   DateTime?                  // scheduled deletion date (10 days after download)
  ageRestriction String   @default("ALL")  // "ALL" = all ages, "18+" = adults only

  // Automatic content inspection for age rating (admin review)
  contentInspectionStatus  String    @default("pending")  // "pending" | "pass" | "review"
  contentInspectionAlertAt DateTime?                      // When alert was first set
  contentInspectionSummary String?                        // Short reason for review (e.g. "Text may suggest mature content")
  
  // Soft delete fields (content hidden but record kept)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedBy     String?   // Admin ID who deleted
  deletionReason String?  // Reason for deletion
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments      Comment[]
  ratings       Rating[]
  reports       Report[]
  purchases     Purchase[]
  savedBy       SavedMedia[]
  versions      MediaVersion[]  // per-resolution variants (YouTube-style)
  celebrationCards CelebrationCard[]

  @@index([userId])
  @@index([type])
  @@index([views])
  @@index([createdAt])
  @@index([isSold])
  @@index([deleteAfter])
  @@index([isDeleted])
  @@index([contentInspectionStatus])
}

// Per-resolution video variant (YouTube-style: 144p–1080p + HQ)
model MediaVersion {
  id        String   @id @default(uuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  label     String   // "144p", "240p", "360p", "480p", "720p", "1080p", "HQ"
  height    Int      // pixel height (for ordering); HQ uses source height
  url       String   // blob URL for this variant
  fileSize  BigInt?  // bytes
  createdAt DateTime @default(now())

  @@index([mediaId])
}

model Comment {
  id            String    @id @default(uuid())
  content       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId       String
  media         Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([userId])
}

model Rating {
  id            String    @id @default(uuid())
  score         Int
  review        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId       String
  media         Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([mediaId])
}

// Anonymous ratings for non-logged-in users
model AnonymousRating {
  id            String    @id @default(uuid())
  visitorId     String    // Browser fingerprint/localStorage ID
  score         Int       // 3=happy, 1=sad
  mediaId       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([visitorId, mediaId])
  @@index([mediaId])
  @@index([visitorId])
}

model Message {
  id            String    @id @default(uuid())
  content       String
  isRead        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  // Relations
  senderId      String
  sender        User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId    String
  receiver      User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
}

model Report {
  id            String    @id @default(uuid())
  reason        String
  status        String    @default("PENDING")
  adminNote     String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  // Relations
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId       String
  media         Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([mediaId])
}

// Site access logs for analytics, support, and security (IP, UA, location, pages, session)
model SiteAccessLog {
  id          String   @id @default(uuid())
  ipAddress   String?
  userAgent   String?  @db.Text
  browser     String?
  os          String?
  device      String?
  city        String?
  region      String?
  country     String?
  path        String   @db.Text
  method      String   @default("GET")
  query       String?  @db.Text
  referrer    String?  @db.Text
  sessionId   String?
  userId      String?
  userName    String?
  userEmail   String?
  statusCode     Int?
  abnormalFlags  String?  @db.Text // JSON string[] — security / probe detection codes (see accessLogAbnormal)
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([userId])
  @@index([path])
  @@index([ipAddress])
}

// Throttle security alert emails: one send per bucket key per flag family per hour
model SecurityAccessAlertDedup {
  bucket    String   @id
  createdAt DateTime @default(now())
}

// Banned client IPs (enforced in middleware when BLOCKED_IP_LIST_SECRET is set)
model BlockedIp {
  id         String   @id @default(uuid())
  ipAddress  String   @unique
  note       String?  @db.Text
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([ipAddress])
}

// Track all admin actions for audit
model AdminAction {
  id            String    @id @default(uuid())
  action        String    // "SUSPEND_USER", "WARN_USER", "GIVE_CREDITS", "DELETE_MEDIA", etc.
  targetType    String    // "USER", "MEDIA", "CHAT_MESSAGE"
  targetId      String    // ID of the target
  details       String?   // JSON details of the action
  adminId       String    // Admin who performed the action
  createdAt     DateTime  @default(now())

  @@index([action])
  @@index([targetId])
  @@index([adminId])
  @@index([createdAt])
}

// Chat message warnings/violations
model ChatWarning {
  id            String    @id @default(uuid())
  messageId     String?   // Optional: specific message that caused warning
  messageContent String?  // Content of the violating message
  reason        String    // Reason for warning
  action        String    @default("WARNING") // "WARNING", "MUTE", "BAN"
  duration      Int?      // Duration in minutes for mute/ban
  adminId       String    // Admin who issued the warning
  createdAt     DateTime  @default(now())

  // Relations
  userId        String
  
  @@index([userId])
  @@index([createdAt])
}

model Purchase {
  id                String    @id @default(uuid())
  amount            Float
  currency          String    @default("usd")
  status            String    @default("pending") // pending, completed, failed, refunded
  stripePaymentId   String?   @unique
  stripeSessionId   String?   @unique
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  // Relations
  buyerId           String
  buyer             User      @relation("Purchases", fields: [buyerId], references: [id], onDelete: Cascade)
  mediaId           String
  media             Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sellerId          String

  @@index([buyerId])
  @@index([mediaId])
  @@index([sellerId])
  @@index([status])
}

model SavedMedia {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())

  // Relations
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId       String
  media         Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId])
  @@index([mediaId])
}

model Notification {
  id            String    @id @default(uuid())
  type          String    // "purchase", "download_reminder", "message", "system"
  title         String
  message       String
  link          String?   // Optional link to navigate to
  read          Boolean   @default(false)
  createdAt     DateTime  @default(now())

  // Relations
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Conversation {
  id        String   @id @default(uuid())
  name      String?  // Optional name for group chats
  isGroup   Boolean  @default(false)  // true for group (3+), false for 1-on-1
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  members   ConversationMember[]
  messages  ChatMessage[]
  
  @@index([createdAt])
  @@index([updatedAt])
}

model ConversationMember {
  id             String    @id @default(uuid())
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime? // Track when user last read messages
  priority       Boolean   @default(false) // User can mark conversation as priority
  
  // Relations
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model ChatMessage {
  id             String    @id @default(uuid())
  content        String
  isPrivate      Boolean   @default(false)  // true for private messages (group or 1-on-1)
  recipientId    String?   // For backward compatibility with old 1-on-1 messages
  conversationId String?   // Link to conversation for group/private chat
  createdAt      DateTime  @default(now())

  // Automatic content inspection for age rating (Open Chat only; admin review)
  contentInspectionStatus  String    @default("pending")  // "pending" | "pass" | "review"
  contentInspectionAlertAt DateTime?
  contentInspectionSummary String?

  // Relations
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
  @@index([isPrivate])
  @@index([recipientId])
  @@index([conversationId])
  @@index([contentInspectionStatus])
}

// Email verification codes (persisted for serverless environments)
model VerificationCode {
  id            String    @id @default(uuid())
  email         String    @unique
  code          String
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

// Phone verification codes for two-step verification (sign up, etc.)
model PhoneVerificationCode {
  id        String   @id @default(uuid())
  phone     String   @unique // normalized: digits only
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

// Pending uploads waiting for payment confirmation
model PendingUpload {
  id            String    @id @default(uuid())
  title         String
  description   String?
  type          String    // VIDEO, IMAGE, MUSIC
  url           String    // Already uploaded to Azure Blob Storage
  thumbnailUrl  String?
  aiTool        String?
  realDevice    String?
  aiPrompt      String?
  price         Float?
  isPublic      Boolean   @default(true)
  stripeSessionId String? @unique
  createdAt     DateTime  @default(now())
  expiresAt     DateTime  // Auto-delete if not completed within 1 hour

  // Relations
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSessionId])
  @@index([expiresAt])
}

model CreditHistory {
  id          String   @id @default(uuid())
  amount      Int      // Positive for credits given, negative for credits used
  type        String   // "bonus", "purchase", "used"
  reason      String?  // Description/comments
  adminId     String?  // Admin who gave the credits (if applicable)
  adminName   String?  // Admin username for display
  createdAt   DateTime @default(now())

  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Membership Plan configuration (managed by admin)
model MembershipPlan {
  id              String    @id @default(uuid())
  planId          String    @unique  // "viewer", "basic", "advanced", "premium"
  name            String              // "Viewer Plan", "Basic Plan", etc.
  monthlyPrice    Float     @default(0)    // Monthly price in USD
  yearlyPrice     Float     @default(0)    // Yearly price in USD
  freeUploads     Int       @default(5)    // Number of free uploads
  pricePerUpload  Float?                   // Price per upload after free (null = Free/NA)
  viewContents    Boolean   @default(true)
  buyContents     Boolean   @default(true)
  sellContents    Boolean   @default(true)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)    // Display order
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([planId])
  @@index([sortOrder])
}

// Promotional Campaign (managed by admin)
model Promotion {
  id              String    @id @default(uuid())
  name            String              // Internal name for the promotion
  description     String?             // Description of the promotion
  
  // Promotion type and value
  type            String              // "subscription_discount", "bonus_uploads", "free_trial"
  discountType    String?             // "percentage", "fixed_amount", "free_months" (for subscription_discount)
  discountValue   Float?              // e.g., 100 for 100%, 2 for $2 off, 1 for 1 free month
  bonusUploads    Int?                // Number of bonus uploads (for bonus_uploads type)
  freeTrialDays   Int?                // Free trial duration (for free_trial type)
  
  // Applicable plans (comma-separated: "basic,advanced,premium" or "all")
  applicablePlans String    @default("all")
  
  // Promo code (optional - leave empty for automatic application)
  promoCode       String?   @unique
  
  // Validity period
  startDate       DateTime  @default(now())
  endDate         DateTime?           // null = no end date
  
  // Usage limits
  usageLimit      Int?                // null = unlimited
  usageCount      Int       @default(0)
  
  // Status
  isActive        Boolean   @default(true)
  
  // Popup configuration
  showPopup       Boolean   @default(false)
  popupTitle      String?
  popupMessage    String?
  popupButtonText String?   @default("Get Offer")
  popupImageUrl   String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
  @@index([promoCode])
  @@index([startDate])
  @@index([endDate])
}

// Track promotion usage per user
model PromotionUsage {
  id            String    @id @default(uuid())
  
  promotionId   String
  userId        String
  
  appliedAt     DateTime  @default(now())
  
  // What was applied
  discountAmount Float?    // Actual discount given
  bonusUploads   Int?      // Bonus uploads given
  
  @@unique([promotionId, userId])
  @@index([promotionId])
  @@index([userId])
}

// Game settings (managed by admin)
model GameSetting {
  id          String    @id @default(uuid())
  gameId      String    @unique  // "tetris", "minesweeper", "donkeykong", "pacman", "breakout", "pong"
  name        String              // Display name
  isEnabled   Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([gameId])
  @@index([isEnabled])
}

// Navbar menu settings (managed by admin)
model NavbarMenuSetting {
  id        String   @id @default(uuid())
  itemKey   String   @unique // "home", "play", "chat", "mediaMessage", "upload", "signIn", "signUp"
  label     String
  isEnabled Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemKey])
  @@index([isEnabled])
}

// Media badge settings (managed by admin)
model MediaBadgeSetting {
  id        String   @id @default(uuid())
  itemKey   String   @unique // "ai", "price", "sold", "views", "postDate", "smileRate"
  label     String
  isEnabled Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemKey])
  @@index([isEnabled])
}

// Crop tool settings (managed by admin) — single-row config table
model CropToolSetting {
  id               String   @id @default(uuid())
  isEnabled        Boolean  @default(true)

  // Paid / Selling content quality (keep original quality)
  imageQuality     Float    @default(0.92)   // 0.0–1.0 (JPEG/WebP quality)
  videoBitrateMbps Float    @default(8.0)    // Video bitrate in Mbps
  videoFps         Int      @default(30)     // Target frames per second
  audioBitrateKbps Int      @default(256)    // Audio bitrate in kbps

  // Free content quality (reduced to save storage / bandwidth)
  freeImageQuality     Float @default(0.75)
  freeVideoBitrateMbps Float @default(4.0)
  freeVideoFps         Int   @default(24)
  freeAudioBitrateKbps Int   @default(128)

  // Download & streaming: max resolution (pixel height) for free vs paid
  freeStreamMaxHeight   Int    @default(720)   // Max height for free streaming (144–1080)
  freeDownloadMaxHeight Int    @default(720)   // Max height for free download
  paidDownloadQuality   String @default("hq")  // "hq" | "1080p" | "720p" for sell/paid download

  // Upload: max file size per blob (main media, thumbnail, avatar) — admin “Upload & Download”
  maxUploadSizeMb       Int    @default(10)    // 1–512 MB clamped in API

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Home feed layout (managed by admin): masonry (CSS columns) or grid (fixed rows)
model HomeLayoutSetting {
  id           String   @id @default(uuid())
  layout       String   @default("masonry")  // "masonry" | "grid"
  preplay      Boolean  @default(true)       // muted video preview on hover on homepage
  ecardEnabled Boolean  @default(true)       // show eCard link in navbar
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Media detail page: show/hide Download, Share, Send by email, and AI Tool metadata (admin)
// shareAppsEnabled: JSON object e.g. { email, whatsapp, kakao, facebook, x, linkedin, reddit, youtube, tiktok, instagram } — Share modal toggles
model MediaDetailSetting {
  id                  String   @id @default(uuid())
  downloadEnabled     Boolean  @default(true)
  shareEnabled        Boolean  @default(true)
  sendByEmailEnabled  Boolean  @default(true)
  aiToolEnabled       Boolean  @default(true) // show "AI Tool: …" when media has aiTool set
  shareAppsEnabled    Json?    // { email, whatsapp, kakao, facebook, x, linkedin, reddit, youtube, tiktok, instagram }
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Celebration e-card: share media as a card via email/SNS with optional TTS message
model CelebrationCard {
  id             String    @id @default(uuid())
  mediaId        String
  media          Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  senderId       String?   // null = anonymous
  sender         User?    @relation("CelebrationCardSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipientEmail String?   // if sent by email
  cardTitle      String?   // e.g. "Happy Birthday!"
  ttsMessage     String?   @db.Text // message read aloud on card view
  expiresAt      DateTime? // optional time-limited link
  createdAt      DateTime  @default(now())

  @@index([mediaId])
  @@index([senderId])
}